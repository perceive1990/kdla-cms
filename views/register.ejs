<%- include('partials/header', { printLandscape: true }) %>
<% const blank = (v, w = '12rem') => v ? v : `<span class="reg-line" style="min-width:${w}"></span>`; let n = 0; %>
<div class="page-head d-print-none">
  <div>
    <div class="crumbs"><a href="<%= back.href %>"><%= back.label %></a></div>
    <h1>Attendance register for signing</h1>
    <p class="sub"><%= info.title %> · <%= sheets.length %> page<%= sheets.length === 1 ? '' : 's' %>, <%= sheets.reduce((s, x) => s + x.length, 0) %> lines</p>
  </div>
  <div class="d-flex flex-wrap gap-2"><button class="btn btn-primary" type="button" data-print><i class="bi bi-printer" aria-hidden="true"></i> Print register</button></div>
</div>
<form class="filters d-print-none" method="get">
  <label class="small">Lines <input class="form-control" type="number" name="rows" min="1" max="400" value="<%= sheets.reduce((s, x) => s + x.length, 0) %>" style="width: 7rem"></label>
  <% if (canName) { %><input type="hidden" name="names" value="0"><label class="form-check small mb-0"><input class="form-check-input" type="checkbox" name="names" value="1"<%= withNames ? ' checked' : '' %>> <%= typeof namesLabel !== 'undefined' ? namesLabel : 'Print the names already registered' %></label><% } %>
  <button class="btn btn-outline-primary" type="submit">Update</button>
  <span class="small text-body-secondary">The first page has 10 lines and each further page 15. Print a few spare pages for unexpected attendees.</span>
</form>

<% sheets.forEach((sheet, pi) => { %>
<section class="reg-sheet">
  <header class="reg-head">
    <img src="/static/images/logo-mark.png?v=<%= assetVersion %>" alt="" width="52" height="46">
    <div class="reg-title">
      <div class="reg-org"><%= config.orgFullName %></div>
      <h2>Attendance register</h2>
    </div>
    <div class="reg-page">Page <%= pi + 1 %> of <%= sheets.length %></div>
  </header>
  <% if (pi === 0) { %>
  <div class="reg-info">
    <div><span>Activity</span><strong><%= info.title %></strong></div>
    <div><span>Type of activity</span><%- blank(info.type) %></div>
    <div><span>Date</span><%- blank(info.date ? h.fmtDate(info.date) : '', '8rem') %></div>
    <div><span>Venue</span><%- blank(info.venue) %></div>
    <div><span>District</span><%- blank(info.district, '8rem') %></div>
    <div><span>Office</span><%- blank(info.office, '8rem') %></div>
    <% if (info.project) { %><div><span>Project</span><%= info.project %><%= info.donor ? ' (' + info.donor + ')' : '' %></div><% } %>
    <% if (info.plan) { %><div><span>Work plan activity</span><%= info.plan %></div><% } %>
    <div><span>Facilitator</span><%- blank(info.facilitator) %></div>
  </div>
  <p class="reg-consent">By signing, I confirm I attended this activity and agree that <%= config.orgName %> records my details for its reports to donors and partners. For people listed in advance, ✓ or ✗ shows the answer already recorded; correct it if it has changed. Tick "Agrees to share" only if you also agree to <%= config.orgName %> sharing your details with partner organisations that can help you.</p>
  <% } else { %>
  <p class="reg-cont"><strong><%= info.title %></strong><%= info.date ? ' · ' + h.fmtDate(info.date) : '' %><%= info.venue ? ' · ' + info.venue : '' %></p>
  <% } %>
  <table class="reg-table">
    <colgroup><col class="r-no"><col class="r-name"><col class="r-name"><col class="r-sex"><col class="r-age"><col class="r-nrc"><col class="r-phone"><col class="r-yn"><col class="r-place"><col class="r-yn"><col class="r-sign"></colgroup>
    <thead><tr>
      <th>No.</th><th>First name</th><th>Last name</th><th>Tick one<div class="reg-sexkey"><span>Girl</span><span>Boy</span><span>Woman</span><span>Man</span></div></th><th>Age</th><th>NRC number <small>(optional)</small></th><th>Phone</th><th>Disability <small>Y / N</small></th><th>Village or area</th><th>Agrees to share <small>tick</small></th><th>Signature or thumbprint</th>
    </tr></thead>
    <tbody>
    <% for (const person of sheet) { n += 1; %>
      <tr>
        <td class="reg-n"><%= n %></td>
        <td><%= person ? person.firstName : '' %></td><td><%= person ? person.lastName : '' %></td>
        <td><div class="reg-boxes"><% for (const a of ['Girl', 'Boy', 'Woman', 'Man']) { %><span class="<%= person && person.ageCategory === a ? 'on' : '' %>"></span><% } %></div></td>
        <td><%= person && person.age ? person.age : '' %></td>
        <td class="reg-id"><%= person && person.nrc ? person.nrc : '' %></td><td class="reg-id"><%= person && person.contact ? person.contact : '' %></td>
        <td class="text-center"><%= person ? ({ Disabled: 'Y', 'Not Disabled': 'N' }[person.disability] || '') : '' %></td><td><%= person && person.location ? person.location : '' %></td><td><% const share = person ? person.consentShare : ''; %><span class="reg-box<%= share === 'yes' ? ' yes' : share === 'no' ? ' no' : '' %>" aria-label="<%= share === 'yes' ? 'Agrees to share' : share === 'no' ? 'Does not agree to share' : 'Not recorded' %>"><%= share === 'yes' ? '✓' : share === 'no' ? '✗' : '' %></span></td><td></td>
      </tr>
    <% } %>
    </tbody>
  </table>
  <footer class="reg-foot">
    <div>Facilitator's name: <span class="reg-line" style="min-width: 14rem"></span></div>
    <div>Signature: <span class="reg-line" style="min-width: 10rem"></span></div>
    <div>Date: <span class="reg-line" style="min-width: 7rem"></span></div>
    <div class="reg-ref"><%= config.appName %> · <%= info.ref %></div>
  </footer>
</section>
<% }) %>
<%- include('partials/footer') %>
