<%- include('../partials/header') %>
<div class="page-head"><div><div class="crumbs"><a href="/admin/projects">Projects</a></div><h1><%= isNew ? 'Add project' : 'Edit project' %></h1></div></div>
<% if (Object.keys(errors).length) { %><div class="alert alert-danger" role="alert">Please correct the highlighted fields.</div><% } %>
<form method="post" action="<%= isNew ? '/admin/projects' : '/admin/projects/' + values.id %>" style="max-width: 760px;" novalidate>
  <%- f.hidden(csrfToken) %>
  <div class="panel"><div class="panel-body row g-3">
    <%- f.text('title', 'Project title', values, errors, { required: true }) %>
    <%- f.text('donor', 'Donor / funding partner', values, errors, { col: 'col-md-6' }) %>
    <%- f.text('startDate', 'Start date', values, errors, { type: 'date', required: true, col: 'col-md-3' }) %>
    <%- f.text('endDate', 'End date', values, errors, { type: 'date', required: true, col: 'col-md-3' }) %>
    <%- f.text('budget', 'Budget', values, errors, { type: 'number', min: 0, step: '0.01', col: 'col-md-4' }) %>
    <%- f.select('currency', 'Currency', ['ZMW', 'DKK', 'USD', 'EUR', 'GBP'], values, errors, { col: 'col-md-2', blank: false }) %>
    <%- f.textarea('description', 'Description', values, errors, { rows: 4 }) %>
  </div></div>
  <div class="d-flex gap-2 mt-3">
    <button class="btn btn-primary" type="submit"><%= isNew ? 'Save project' : 'Save changes' %></button>
    <a class="btn btn-outline-secondary" href="/admin/projects">Cancel</a>
  </div>
</form>
<%- include('../partials/footer') %>
