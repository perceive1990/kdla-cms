<%- include('../partials/header') %>
<div class="page-head"><div><div class="crumbs"><a href="/admin/users">Staff accounts</a></div><h1><%= isNew ? 'Add staff account' : 'Edit ' + values.username %></h1></div></div>
<% if (Object.keys(errors).length) { %><div class="alert alert-danger" role="alert">Please correct the highlighted fields.</div><% } %>
<form method="post" action="<%= isNew ? '/admin/users' : '/admin/users/' + values.id %>" style="max-width: 760px;" novalidate>
  <%- f.hidden(csrfToken) %>
  <div class="panel"><div class="panel-body row g-3">
    <% if (isNew) { %>
      <%- f.text('username', 'Username', values, errors, { required: true, col: 'col-md-6', autocomplete: 'off', help: 'Lowercase, used to log in.' }) %>
    <% } else { %>
      <div class="col-md-6"><label class="form-label">Username</label><input class="form-control" value="<%= values.username %>" disabled></div>
    <% } %>
    <%- f.text('fullName', 'Full name', values, errors, { required: true, col: 'col-md-6' }) %>
    <%- f.text('email', 'Email', values, errors, { type: 'email', col: 'col-md-6' }) %>
    <%- f.select('role', 'Role', [{ value: 'officer', label: 'Officer' }, { value: 'admin', label: 'Administrator' }], values, errors, { col: 'col-md-6', blank: false }) %>
    <%- f.select('category', 'Category', choices.userCategories, values, errors, { col: 'col-md-4' }) %>
    <%- f.select('qualification', 'Qualification level', choices.qualificationLevels, values, errors, { col: 'col-md-4' }) %>
    <%- f.select('office', 'Office', choices.offices, values, errors, { col: 'col-md-4' }) %>
    <%- f.text('password', isNew ? 'Temporary password' : 'Reset password', {}, errors, { type: 'password', required: isNew, col: 'col-md-6', autocomplete: 'new-password', help: isNew ? 'At least 10 characters. They should change it after logging in.' : 'Leave blank to keep the current password.' }) %>
    <%- f.checkbox('active', 'Account is active (can log in)', values.active !== false, { col: 'col-md-6 align-self-end' }) %>
    <% if (!isNew) { %>
      <% if (values.lockedUntil && new Date(values.lockedUntil) > new Date()) { %>
        <%- f.checkbox('unlock', 'Unlock this account (locked after too many wrong passwords)', false, { col: 'col-md-6' }) %>
      <% } %>
      <% if (values.totpEnabled) { %>
        <%- f.checkbox('reset2fa', 'Reset two-step verification (for a lost phone; they will set it up again)', false, { col: 'col-md-6' }) %>
      <% } %>
      <div class="col-12 small text-body-secondary">Resetting the password, changing the role, disabling the account or resetting two-step verification signs the person out on all devices.</div>
    <% } %>
  </div></div>
  <div class="d-flex gap-2 mt-3">
    <button class="btn btn-primary" type="submit"><%= isNew ? 'Create account' : 'Save changes' %></button>
    <a class="btn btn-outline-secondary" href="/admin/users">Cancel</a>
  </div>
</form>
<%- include('../partials/footer') %>
