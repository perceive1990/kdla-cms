<%- include('partials/header') %>
<% const caseLabel = (t) => { const c = t.caseId && taskCases[t.caseId]; return c ? c.caseNumber + (c.redacted ? '' : ' · ' + c.heading) : ''; }; %>
<div class="page-head">
  <div>
    <h1>Dashboard</h1>
    <p class="sub">Good to see you, <%= user.fullName || user.username %>. Here is your work and KDLA's caseload.</p>
  </div>
  <div class="d-flex flex-wrap gap-2">
    <a class="btn btn-outline-primary" href="/conflicts"><i class="bi bi-exclamation-diamond"></i> Conflict check</a>
    <a class="btn btn-outline-primary" href="/people/clients/new?then=case"><i class="bi bi-person-plus"></i> New client</a>
    <a class="btn btn-primary" href="/cases/new"><i class="bi bi-plus-lg"></i> New case</a>
  </div>
</div>

<div class="row g-3 mb-3">
  <div class="col-6 col-lg-3"><a class="stat" href="/cases?officer=me&status=open"><div class="label">My open cases</div><div class="value"><%= stats.mine %></div></a></div>
  <div class="col-6 col-lg-3"><a class="stat<%= stats.overdue ? ' alert-stat' : '' %>" href="/tasks"><div class="label">My overdue tasks</div><div class="value"><%= stats.overdue %></div></a></div>
  <div class="col-6 col-lg-3"><a class="stat" href="/cases?status=open"><div class="label">All open cases</div><div class="value"><%= stats.open %></div></a></div>
  <div class="col-6 col-lg-3"><a class="stat" href="/referrals?followUp=Needs+follow+up"><div class="label">Referrals needing follow up</div><div class="value"><%= stats.openReferrals %></div></a></div>
</div>

<div class="row g-3">
  <div class="col-lg-8">
    <div class="panel"><div class="panel-body">
      <div class="panel-head">
        <h2 class="panel-title">My tasks for the next two weeks</h2>
        <a class="small" href="/tasks/new">Add task</a>
      </div>
      <% if (!myTasks.length) { %>
        <p class="text-body-secondary mb-0">Nothing due. Add hearings, mediation sessions and deadlines from a case page so nothing is missed.</p>
      <% } %>
      <% for (const t of myTasks) { const overdue = t.dueDate < t0; %>
        <div class="task-row">
          <div class="when <%= overdue ? 'text-danger fw-semibold' : '' %>"><%= h.fmtDate(t.dueDate) %><%= t.dueTime ? ' ' + t.dueTime : '' %><% if (overdue) { %><div class="small">Overdue</div><% } %></div>
          <div class="grow">
            <div class="title"><span class="tag tag-muted"><%= t.type %></span> <%= t.title %></div>
            <% if (t.caseId) { %><div class="small"><a href="/cases/<%= t.caseId %>"><%= caseLabel(t) %></a></div><% } %>
          </div>
          <form method="post" action="/tasks/<%= t.id %>/done">
            <%- f.hidden(csrfToken) %>
            <button class="btn btn-sm btn-outline-primary" type="submit" title="Mark done"><i class="bi bi-check2"></i><span class="visually-hidden">Mark <%= t.title %> done</span></button>
          </form>
        </div>
      <% } %>
    </div></div>

    <div class="panel"><div class="panel-body">
      <div class="panel-head">
        <h2 class="panel-title">Recently updated cases</h2>
        <a href="/cases" class="small">All cases</a>
      </div>
      <% if (!recent.length) { %>
        <div class="empty"><i class="bi bi-folder2-open"></i>No cases yet. <a href="/cases/new">Open the first case</a>.</div>
      <% } else { %>
      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead><tr><th>Case</th><th>Client</th><th>Status</th><th class="d-none d-md-table-cell">Officer</th><th class="d-none d-md-table-cell">Updated</th></tr></thead>
          <tbody>
          <% for (const c of recent) { %>
            <tr>
              <td><a class="cell-strong" href="/cases/<%= c.id %>"><%= c.heading %></a><% if (c.restricted) { %> <i class="bi bi-lock-fill text-warning" title="Confidential"></i><% } %><div class="text-body-secondary small"><%= c.caseNumber %></div></td>
              <td><%= (c.clientIds || []).map((id) => h.fullName(people[id])).filter(Boolean).join(', ') %></td>
              <td><span class="badge text-bg-<%= h.statusBadge(c.status) %> badge-status"><%= c.status %></span></td>
              <td class="d-none d-md-table-cell"><%= users[c.officerId] ? (users[c.officerId].fullName || users[c.officerId].username) : '' %></td>
              <td class="d-none d-md-table-cell nowrap"><%= h.fmtDate(c.updatedAt) %></td>
            </tr>
          <% } %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div></div>

    <div class="row g-3 mt-0">
      <div class="col-md-6">
        <div class="panel h-100"><div class="panel-body">
          <h2 class="panel-title">Cases by status</h2>
          <%- include('partials/bars', { rows: byStatus, link: (l) => '/cases?status=' + encodeURIComponent(l) }) %>
        </div></div>
      </div>
      <div class="col-md-6">
        <div class="panel h-100"><div class="panel-body">
          <h2 class="panel-title">Cases by type</h2>
          <%- include('partials/bars', { rows: byType, link: (l) => '/cases?type=' + encodeURIComponent(l) }) %>
        </div></div>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="panel"><div class="panel-body">
      <div class="panel-head">
        <h2 class="panel-title">Hearings and mediations, next 14 days</h2>
      </div>
      <% if (!hearings.length) { %><p class="text-body-secondary mb-0">None scheduled.</p><% } %>
      <% for (const t of hearings) { %>
        <div class="task-row">
          <div class="when"><%= h.fmtDate(t.dueDate) %><%= t.dueTime ? ' ' + t.dueTime : '' %></div>
          <div class="grow"><div><%= t.title %></div>
            <div class="small text-body-secondary"><%= t.type %><%= t.location ? ' · ' + t.location : '' %><%= users[t.assigneeId] ? ' · ' + (users[t.assigneeId].fullName || users[t.assigneeId].username) : '' %></div></div>
        </div>
      <% } %>
    </div></div>

    <div class="panel"><div class="panel-body">
      <h2 class="panel-title">Clients reached</h2>
      <div class="d-flex align-items-baseline gap-2 mb-3">
        <span class="fs-2 fw-bold"><%= stats.clients %></span><span class="text-body-secondary">registered clients</span>
      </div>
      <%- include('partials/bars', { rows: byAgeCategory, link: (l) => '/people/clients?ageCategory=' + encodeURIComponent(l) }) %>
      <p class="small text-body-secondary mb-0 mt-2"><%= h.plural(disabled, 'client') %> with a disability recorded.</p>
    </div></div>

    <div class="panel"><div class="panel-body">
      <h2 class="panel-title">Results</h2>
      <dl class="dl dl-tight mb-0">
        <dt>Cases opened this year</dt><dd class="num-col"><%= stats.thisYear %></dd>
        <dt>Cases concluded</dt><dd class="num-col"><%= stats.concluded %></dd>
        <dt>Resolved in the client's favour</dt><dd class="num-col"><%= stats.resolved %></dd>
        <dt>Activity reports</dt><dd class="num-col"><%= stats.reports %></dd>
      </dl>
      <a class="small d-inline-block mt-2" href="/statistics">Full statistics for a period</a>
    </div></div>

    <div class="panel"><div class="panel-body">
      <h2 class="panel-title">Cases by office</h2>
      <%- include('partials/bars', { rows: byOffice, link: (l) => '/cases?office=' + encodeURIComponent(l) }) %>
    </div></div>
  </div>
</div>
<%- include('partials/footer') %>
