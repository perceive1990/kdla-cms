<%- include('../partials/header') %>
<div class="page-head">
  <div>
    <div class="crumbs"><a href="/stakeholders">Stakeholders</a><% if (!isNew) { %> / <a href="/stakeholders/<%= values.id %>"><%= values.name %></a><% } %></div>
    <h1><%= isNew ? 'Add stakeholder organisation' : 'Edit ' + values.name %></h1>
  </div>
</div>
<% if (Object.keys(errors).length) { %><div class="alert alert-danger" role="alert">Please correct the highlighted fields.</div><% } %>
<form method="post" action="<%= isNew ? '/stakeholders' : '/stakeholders/' + values.id %>" novalidate>
  <%- f.hidden(csrfToken, isNew ? null : values._etag) %>
  <div class="panel"><div class="panel-body row g-3">
    <%- f.text('name', 'Name of organisation', values, errors, { required: true }) %>
    <%- f.textarea('description', 'Description', values, errors, { rows: 4, placeholder: 'What the organisation does' }) %>
    <%- f.textarea('services', 'Services offered to referred clients', values, errors, { rows: 3 }) %>
    <%- f.textarea('address', 'Address', values, errors, { rows: 2 }) %>
    <%- f.text('contactPerson', 'Contact person', values, errors, { required: true, col: 'col-md-4' }) %>
    <%- f.text('phone', 'Phone', values, errors, { required: true, col: 'col-md-4', type: 'tel', autocomplete: 'off' }) %>
    <%- f.text('email', 'Email', values, errors, { col: 'col-md-4', type: 'email' }) %>
  </div></div>
  <div class="d-flex gap-2 mt-3">
    <button class="btn btn-primary" type="submit"><%= isNew ? 'Save' : 'Save changes' %></button>
    <a class="btn btn-outline-secondary" href="<%= isNew ? '/stakeholders' : '/stakeholders/' + values.id %>">Cancel</a>
  </div>
</form>
<%- include('../partials/footer') %>
