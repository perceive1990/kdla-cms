<%- include('../partials/header') %>
<div class="page-head">
  <div><div class="crumbs"><a href="/stakeholders">Stakeholders</a></div><h1><%= s.name %></h1></div>
  <a class="btn btn-primary" href="/stakeholders/<%= s.id %>/edit"><i class="bi bi-pencil"></i> Edit</a>
</div>
<div class="row g-3">
  <div class="col-lg-7">
    <div class="panel"><div class="panel-body">
      <dl class="dl">
        <dt>Description</dt><dd class="prose"><%= s.description || '—' %></dd>
        <dt>Services</dt><dd class="prose"><%= s.services || '—' %></dd>
        <dt>Address</dt><dd class="prose"><%= s.address || '—' %></dd>
        <dt>Contact person</dt><dd><%= s.contactPerson %></dd>
        <dt>Phone</dt><dd><a href="tel:<%= s.phone %>"><%= s.phone %></a></dd>
        <dt>Email</dt><dd><%- s.email ? '<a href="mailto:' + f.esc(s.email) + '">' + f.esc(s.email) + '</a>' : '—' %></dd>
      </dl>
    </div></div>
    <% if (user.role === 'admin') { %>
    <form method="post" action="/stakeholders/<%= s.id %>/delete" class="mt-3" data-confirm="Delete <%= s.name %>?">
      <%- f.hidden(csrfToken) %>
      <button class="btn btn-outline-danger btn-sm" type="submit"><i class="bi bi-trash"></i> Delete</button>
    </form>
    <% } %>
  </div>
  <div class="col-lg-5">
    <div class="panel"><div class="panel-body">
      <h2 class="panel-title">Referrals to this organisation (<%= referrals.length %>)</h2>
      <% if (!referrals.length) { %><p class="text-muted mb-0">None yet.</p><% } %>
      <ul class="list-unstyled mb-0">
        <% for (const r of referrals) { const c = cases[r.caseId]; %>
        <li class="py-2 border-bottom"><a href="/referrals/<%= r.id %>"><%= c ? c.heading : 'Case removed' %></a>
          <div class="small text-muted"><%= h.fmtDate(r.createdAt) %> · <%= r.followUp %></div></li>
        <% } %>
      </ul>
    </div></div>
  </div>
</div>
<%- include('../partials/footer') %>
