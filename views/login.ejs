<%- include('partials/header') %>
<div class="auth">
  <%- include('partials/auth-brand') %>
  <div class="auth-main">
    <div class="auth-card">
      <h1><%= config.appName %></h1>
      <p class="lede">Log in with your staff username and password.</p>
      <% if (error) { %>
        <div class="alert alert-danger py-2" role="alert"><%= error %></div>
      <% } else if (notice) { %>
        <div class="alert alert-info py-2" role="status"><%= notice %></div>
      <% } %>
      <form method="post" action="/login" class="row g-3">
        <%- f.hidden(csrfToken) %>
        <input type="hidden" name="next" value="<%= next %>">
        <%- f.text('username', 'Username', { username }, {}, { required: true, autocomplete: 'username' }) %>
        <%- f.text('password', 'Password', {}, {}, { type: 'password', required: true, autocomplete: 'current-password' }) %>
        <div class="col-12 d-grid mt-4">
          <button type="submit" class="btn btn-primary">Log in</button>
        </div>
      </form>
      <div class="text-center mt-3" data-install-offer hidden>
        <button type="button" class="btn btn-sm btn-outline-primary" data-install-app><i class="bi bi-download" aria-hidden="true"></i> Install <%= config.appShortName %> on this device</button>
      </div>
      <p class="auth-note">Forgot your password? Ask an administrator to reset it.<br>
        This system holds confidential client information. Authorised staff only.</p>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
