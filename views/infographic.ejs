<%- include('partials/header') %>
<% const qs = new URLSearchParams({ from: p.from, to: p.to, office: p.office, projectId: p.projectId }).toString(); %>
<div class="page-head d-print-none">
  <div><div class="crumbs"><a href="/statistics?<%= qs %>">Statistics</a></div><h1>Infographic</h1><p class="sub">A one-page summary of results to print or save as PDF for donors, the board and community meetings</p></div>
  <div class="d-flex gap-2">
    <button class="btn btn-primary" type="button" data-print><i class="bi bi-printer"></i> Print or save as PDF</button>
  </div>
</div>

<form class="filters d-print-none" method="get" action="/statistics/infographic">
  <label class="small" for="from">From</label>
  <input class="form-control" type="date" id="from" name="from" value="<%= p.from %>">
  <label class="small" for="to">to</label>
  <input class="form-control" type="date" id="to" name="to" value="<%= p.to %>">
  <select class="form-select" name="office" aria-label="Office">
    <option value="">All offices</option>
    <% for (const o of choices.offices) { %><option<%= p.office === o ? ' selected' : '' %>><%= o %></option><% } %>
  </select>
  <% if (projects.length) { %>
  <select class="form-select" name="projectId" aria-label="Project">
    <option value="">All projects</option>
    <% for (const pr of projects) { %><option value="<%= pr.id %>"<%= p.projectId === pr.id ? ' selected' : '' %>><%= pr.title %></option><% } %>
  </select>
  <% } %>
  <button class="btn btn-outline-primary" type="submit">Show</button>
</form>

<% if (!s) { %>
  <div class="panel"><div class="empty">The start date must be before the end date.</div></div>
<% } else { %>
<article class="infographic">
  <header class="ig-head">
    <img src="/static/images/logo.png" alt="" width="64" height="54">
    <div>
      <h2><%= config.orgFullName %> in numbers</h2>
      <p><%= h.fmtDate(p.from) %> to <%= h.fmtDate(p.to) %><%= p.office ? ' · ' + p.office : '' %><%= project ? ' · ' + project.title : '' %></p>
    </div>
  </header>

  <section class="ig-tiles" aria-label="Headline figures">
    <% for (const t of [
      ['people', 'People reached', s.totals.reach, 'through activities and community meetings'],
      ['person-vcard', 'Clients served', s.totals.served, 'on cases opened in the period'],
      ['folder2-open', 'Cases opened', s.totals.opened, s.totals.openNow + ' open cases today'],
      ['check2-circle', 'Cases concluded', s.totals.closed, s.totals.medianDays !== null ? 'median ' + s.totals.medianDays + ' days to conclude' : 'in the period'],
      ['arrow-left-right', 'Referrals to partners', s.totals.referrals, s.totals.followUps + ' follow ups'],
      ['clock-history', 'Hours of legal support', s.totals.hoursLogged, 'recorded in case diaries'],
    ]) { %>
    <div class="ig-tile">
      <i class="bi bi-<%= t[0] %>" aria-hidden="true"></i>
      <div class="ig-num"><%= charts.num(t[2]) %></div>
      <div class="ig-label"><%= t[1] %></div>
      <div class="ig-note"><%= t[3] %></div>
    </div>
    <% } %>
  </section>

  <div class="ig-grid">
    <section class="ig-card">
      <h3>Cases resolved</h3>
      <% if (s.totals.resolvedRate === null) { %>
        <p class="small text-body-secondary mb-0">No cases were concluded in this period.</p>
      <% } else { %>
        <div class="ig-big"><%= s.totals.resolvedRate %>%</div>
        <%- charts.meter(s.totals.resolvedRate, { title: 'Concluded cases resolved' }) %>
        <p class="ig-note mt-2 mb-0">of the <%= s.totals.closed %> cases concluded were resolved, through mediation, negotiation, traditional authorities, advice, a partner or a court decision in the client's favour.</p>
      <% } %>
    </section>

    <section class="ig-card">
      <h3>Clients served, by age and sex</h3>
      <%- charts.hbars(s.servedByAge, { title: 'Clients served by age and sex', unit: 'clients', labelWidth: 90 }) %>
      <p class="ig-note mt-2 mb-0"><%= s.servedDisabled %> clients with a disability</p>
    </section>

    <section class="ig-card ig-wide">
      <h3>Cases opened each month</h3>
      <%- charts.columns(months, { title: 'Cases opened each month', unit: 'cases' }) %>
    </section>

    <section class="ig-card">
      <h3>Types of cases</h3>
      <%- charts.hbars(types, { title: 'Cases opened by type', unit: 'cases', max: 6 }) %>
    </section>

    <section class="ig-card">
      <h3>How concluded cases ended</h3>
      <%- charts.hbars(outcomes, { title: 'Concluded cases by outcome', unit: 'cases', max: 6, labelWidth: 170 }) %>
    </section>

    <section class="ig-card">
      <h3>Community activities</h3>
      <%- charts.hbars(activities, { title: 'Activities by type', unit: 'activities', max: 6 }) %>
      <p class="ig-note mt-2 mb-0"><%= s.totals.activities %> activities · <%= s.totals.registeredAttendees %> registered attendees · <%= s.totals.otherParticipants %> more counted</p>
    </section>

    <section class="ig-card">
      <h3>Activities by district</h3>
      <%- charts.hbars(districts, { title: 'Activities by district', unit: 'activities', max: 6 }) %>
    </section>
  </div>

  <footer class="ig-foot">Source: <%= config.appName %>, <%= h.fmtDate(generated) %>. People reached counts registered attendees plus participants counted without registration.</footer>
</article>
<% } %>
<%- include('partials/footer') %>
