<%- include('../partials/header') %>
<div class="page-head"><div><div class="crumbs"><a href="/rooms">Consultation rooms</a></div><h1>New consultation room</h1><p class="sub">Only the colleagues you add can read the discussion.</p></div></div>
<form method="post" action="/rooms" novalidate>
  <%- f.hidden(csrfToken) %>
  <div class="panel"><div class="panel-body row g-3">
    <fieldset class="col-12">
      <legend class="form-label fs-6">What is this room for? <span class="text-danger" aria-hidden="true">*</span></legend>
      <div class="choice-grid room-kinds" role="radiogroup" aria-label="Room type">
        <% for (const k of kinds) { %>
        <label class="choice">
          <input type="radio" name="kind" value="<%= k.value %>"<%= values.kind === k.value ? ' checked' : '' %> data-room-kind>
          <div class="fw-semibold"><i class="bi <%= k.value === 'case' ? 'bi-folder2-open' : 'bi-briefcase' %>"></i> <%= k.label %></div>
          <div class="small text-body-secondary"><%= k.help %></div>
        </label>
        <% } %>
      </div>
      <% if (errors.kind) { %><div class="invalid-feedback d-block"><%= errors.kind %></div><% } %>
    </fieldset>
    <div class="col-12 row g-3 m-0 p-0" id="room-case"<%= values.kind === 'management' ? ' hidden' : '' %>>
      <%- f.select('caseId', 'Case', cases.map((c) => ({ value: c.id, label: c.caseNumber + ' · ' + c.heading })), values, errors, { required: true, blank: 'Select the case…', help: 'Colleagues you add must be able to open this case.' }) %>
    </div>
    <%- f.text('name', 'Topic', values, errors, { required: true, maxlength: 100, placeholder: values.kind === 'management' ? 'e.g. Staff field schedule for November' : 'e.g. Advice on customary land dispute in Fisenge' }) %>
    <%- f.textarea('description', 'What do you want to consult about?', values, errors, { rows: 4 }) %>
  </div></div>
  <div class="d-flex gap-2 mt-3">
    <button class="btn btn-primary" type="submit">Create room</button>
    <a class="btn btn-outline-secondary" href="/rooms">Cancel</a>
  </div>
</form>
<%- include('../partials/footer') %>
