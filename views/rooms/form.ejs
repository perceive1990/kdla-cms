<%- include('../partials/header') %>
<div class="page-head"><div><div class="crumbs"><a href="/rooms">Consultation rooms</a></div><h1>New consultation room</h1></div></div>
<form method="post" action="/rooms" novalidate>
  <%- f.hidden(csrfToken) %>
  <div class="panel"><div class="panel-body row g-3">
    <%- f.text('name', 'Topic', values, errors, { required: true, maxlength: 100, placeholder: 'e.g. Advice on customary land dispute in Fisenge' }) %>
    <%- f.textarea('description', 'What do you want to consult about?', values, errors, { rows: 4 }) %>
    <%- f.select('caseId', 'Related case (optional)', cases.map((c) => ({ value: c.id, label: c.caseNumber + ' · ' + c.heading })), values, errors, { blank: 'No specific case' }) %>
  </div></div>
  <div class="d-flex gap-2 mt-3">
    <button class="btn btn-primary" type="submit">Create room</button>
    <a class="btn btn-outline-secondary" href="/rooms">Cancel</a>
  </div>
</form>
<%- include('../partials/footer') %>
