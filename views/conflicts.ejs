<%- include('partials/header') %>
<div class="page-head">
  <div><h1>Conflict check</h1>
    <p class="sub">Before taking on a new matter, check whether KDLA already acts for, or against, any of the people involved.</p></div>
</div>
<form class="panel mb-3" method="get" action="/conflicts" role="search">
  <div class="panel-body row g-3 align-items-end">
    <div class="col-md-6">
      <label class="form-label" for="name">Full name</label>
      <input class="form-control" id="name" name="name" value="<%= name %>" placeholder="e.g. John Mansa" autocomplete="off">
    </div>
    <div class="col-md-3">
      <label class="form-label" for="nrc">NRC (optional)</label>
      <input class="form-control" id="nrc" name="nrc" value="<%= nrc %>" placeholder="123456/78/1">
    </div>
    <div class="col-md-3 d-grid"><button class="btn btn-primary" type="submit"><i class="bi bi-search"></i> Check</button></div>
  </div>
</form>

<% if (searched) { %>
  <% if (!results.length) { %>
    <div class="callout callout-info">No client or other party matches. No conflict found in KDLA's records.</div>
  <% } else { %>
    <div class="callout mb-3">
      <strong><%= h.plural(results.length, 'possible match', 'possible matches') %>.</strong>
      Check each one. A conflict exists if KDLA would act against someone it already serves, or for someone against an existing client.
    </div>
    <div class="table-wrap">
      <table class="table align-middle">
        <thead><tr><th>Person</th><th>Recorded as</th><th>NRC</th><th>Cases</th></tr></thead>
        <tbody>
        <% for (const r of results) { const p = r.p; const slug = p.kind === 'client' ? 'clients' : 'defendants'; %>
          <tr>
            <td><a class="cell-strong" href="/people/<%= slug %>/<%= p.id %>"><%= h.fullName(p) %></a>
              <% if (r.exact) { %><span class="tag tag-danger">Exact match</span><% } else { %><span class="tag tag-muted">Similar name</span><% } %></td>
            <td><%= p.kind === 'client' ? 'KDLA client' : 'Other party (opponent)' %></td>
            <td class="nowrap"><%= p.nrc || '—' %></td>
            <td>
              <% if (!r.cases.length) { %><span class="text-body-secondary">No cases</span><% } %>
              <% for (const c of r.cases) { %>
                <div><a href="/cases/<%= c.id %>"><%= c.caseNumber %></a> · <%= c.heading %><% if (c.redacted) { %> <i class="bi bi-lock-fill text-warning" title="Confidential"></i><% } %> <span class="text-body-secondary small">(<%= c.status %>)</span></div>
              <% } %>
            </td>
          </tr>
        <% } %>
        </tbody>
      </table>
    </div>
  <% } %>
<% } %>
<%- include('partials/footer') %>
