<%- include('../partials/header') %>
<div class="page-head">
  <div>
    <div class="crumbs"><a href="/logframes">M&amp;E</a> / <a href="/logframes/<%= project.id %>"><%= project.title %></a></div>
    <h1><%= isNew ? 'Add indicator' : 'Edit indicator' %></h1>
  </div>
</div>
<% if (Object.keys(errors).length) { %><div class="alert alert-danger" role="alert">Please correct the highlighted fields.</div><% } %>
<form method="post" action="/logframes/<%= project.id %>/indicators<%= isNew ? '' : '/' + values.id %>" novalidate>
  <%- f.hidden(csrfToken) %>
  <div class="panel"><div class="panel-body row g-3">
    <%- f.select('resultId', 'Measures', results, values, errors, { required: true, blank: 'Choose the result…' }) %>
    <%- f.textarea('name', 'Indicator', values, errors, { required: true, rows: 2, placeholder: 'e.g. Community members reached through awareness raising and referral information' }) %>
    <% const groups = {}; for (const [key, s] of Object.entries(SOURCES)) (groups[s.group] = groups[s.group] || []).push([key, s]); %>
    <div class="col-12">
      <label class="form-label" for="source">Where the value comes from <span class="text-danger" aria-hidden="true">*</span></label>
      <select class="form-select<%= errors.source ? ' is-invalid' : '' %>" id="source" name="source" aria-describedby="source-help">
        <% for (const [group, list] of Object.entries(groups)) { %>
          <optgroup label="<%= group %>">
            <% for (const [key, s] of list) { %><option value="<%= key %>"<%= values.source === key ? ' selected' : '' %>><%= s.label %></option><% } %>
          </optgroup>
        <% } %>
      </select>
      <% if (errors.source) { %><div class="invalid-feedback d-block"><%= errors.source %></div><% } %>
      <div class="form-text" id="source-help">"Recorded by staff" means colleagues enter the value from time to time. The other choices are worked out by the system: from the activity reports of the planned activities linked to this result and everything under it, or from the case records of the project period.</div>
    </div>
    <%- f.select('unit', 'Unit', [{ value: 'number', label: 'Number' }, { value: 'percent', label: 'Percent' }], values, errors, { col: 'col-md-3', blank: false, help: 'Automatic sources set this themselves' }) %>
    <%- f.text('baseline', 'Baseline', values, errors, { col: 'col-md-3', inputmode: 'decimal' }) %>
    <%- f.text('target', 'Target', values, errors, { col: 'col-md-3', inputmode: 'decimal', help: 'For the end of the project' }) %>
    <%- f.text('frequency', 'How often measured', values, errors, { col: 'col-md-3', maxlength: 100, placeholder: 'e.g. Quarterly' }) %>
    <%- f.text('means', 'Means of verification', values, errors, { maxlength: 500, placeholder: 'e.g. Attendance registers and activity reports' }) %>
  </div></div>
  <div class="d-flex gap-2 mt-3">
    <button class="btn btn-primary" type="submit"><%= isNew ? 'Add indicator' : 'Save changes' %></button>
    <a class="btn btn-outline-secondary" href="/logframes/<%= project.id %>">Cancel</a>
  </div>
</form>
<% if (!isNew) { %>
<form method="post" action="/logframes/<%= project.id %>/indicators/<%= values.id %>/delete" class="mt-4" data-confirm="Remove this indicator and all its recorded values?">
  <%- f.hidden(csrfToken) %><button class="btn btn-outline-danger btn-sm" type="submit"><i class="bi bi-trash" aria-hidden="true"></i> Remove indicator</button>
</form>
<% } %>
<%- include('../partials/footer') %>
