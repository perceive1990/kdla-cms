<%- include('../partials/header') %>
<div class="page-head">
  <div>
    <div class="crumbs"><a href="/logframes">M&amp;E</a> / <a href="/logframes/<%= project.id %>"><%= project.title %></a></div>
    <h1>Logframe settings</h1>
  </div>
</div>
<form method="post" action="/logframes/<%= project.id %>/settings" novalidate>
  <%- f.hidden(csrfToken, fw._etag) %>
  <div class="panel"><div class="panel-body row g-3">
    <h2 class="panel-title">Names of the levels</h2>
    <p class="small text-body-secondary mb-0">Use the donor's words, for example Goal, Outcome, Output and Activity.</p>
    <%- f.text('name_objective', 'Top level', values, errors, { col: 'col-md-3', maxlength: 60 }) %>
    <%- f.text('name_outcome', 'Second level', values, errors, { col: 'col-md-3', maxlength: 60 }) %>
    <%- f.text('name_output', 'Third level', values, errors, { col: 'col-md-3', maxlength: 60 }) %>
    <%- f.text('name_activity', 'Fourth level', values, errors, { col: 'col-md-3', maxlength: 60 }) %>
    <%- f.textarea('notes', 'Notes', values, errors, { rows: 4, help: 'Optional: assumptions, risks, or where the full results framework is kept.' }) %>
  </div></div>
  <div class="d-flex gap-2 mt-3">
    <button class="btn btn-primary" type="submit">Save</button>
    <a class="btn btn-outline-secondary" href="/logframes/<%= project.id %>">Cancel</a>
  </div>
</form>
<div class="panel mt-4"><div class="panel-body">
  <h2 class="panel-title">Delete the logframe</h2>
  <p class="small text-body-secondary">Removes all results, indicators and recorded values, for example to import a corrected version. Work plans and activity reports are kept; their planned activities are unlinked.</p>
  <form method="post" action="/logframes/<%= project.id %>/delete" data-confirm="Delete the whole logframe of <%= project.title %>, with its indicators and recorded values?">
    <%- f.hidden(csrfToken) %><button class="btn btn-outline-danger" type="submit"><i class="bi bi-trash" aria-hidden="true"></i> Delete the logframe</button>
  </form>
</div></div>
<%- include('../partials/footer') %>
