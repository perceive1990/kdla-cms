<%- include('../partials/header') %>
<div class="page-head">
  <div>
    <div class="crumbs"><a href="/logframes">M&amp;E</a> / <a href="/logframes/<%= project.id %>"><%= project.title %></a></div>
    <h1>Import the logframe</h1>
    <p class="sub">From Excel or a CSV file: one row per objective, output, activity or indicator</p>
  </div>
  <a class="btn btn-outline-secondary" href="/logframes/template.csv"><i class="bi bi-download" aria-hidden="true"></i> Download the template</a>
</div>
<% if (error) { %><div class="alert alert-danger" role="alert"><%= error %></div><% } %>
<% if (Object.keys(rowErrors).length) { %>
  <div class="alert alert-warning"><ul class="mb-0"><% for (const msg of Object.values(rowErrors)) { %><li><%= msg %></li><% } %></ul></div>
<% } %>
<div class="row g-3">
  <div class="col-lg-7">
    <form method="post" action="/logframes/<%= project.id %>/import" enctype="multipart/form-data" class="panel" novalidate>
      <div class="panel-body row g-3">
        <%- f.hidden(csrfToken) %>
        <div class="col-12">
          <label class="form-label" for="attachments">CSV file</label>
          <input class="form-control" type="file" id="attachments" name="attachments" accept=".csv,text/csv,text/plain">
          <div class="form-text">In Excel: File &gt; Save As &gt; CSV UTF-8.</div>
        </div>
        <div class="col-12">
          <label class="form-label" for="outline">Or paste the rows</label>
          <textarea class="form-control font-monospace small" id="outline" name="outline" rows="12" placeholder="Select the rows in Excel, copy, and paste them here"><%= outline %></textarea>
        </div>
        <div class="col-12"><button class="btn btn-primary" type="submit"><i class="bi bi-upload" aria-hidden="true"></i> Import</button>
          <a class="btn btn-outline-secondary" href="/logframes/<%= project.id %>">Cancel</a></div>
      </div>
    </form>
  </div>
  <div class="col-lg-5">
    <div class="panel"><div class="panel-body small">
      <h2 class="panel-title">The columns</h2>
      <ol class="mb-2">
        <li><strong>Level</strong>: Overall objective, Intermediate objective (or Outcome), Output, Activity or Indicator</li>
        <li><strong>Code</strong>: optional, for example 1.2. Empty numbers it automatically</li>
        <li><strong>Text</strong>: the result, activity or indicator</li>
        <li><strong>Unit</strong>: Number or Percent (indicators only)</li>
        <li><strong>Baseline</strong> and <strong>Target</strong> (indicators only)</li>
        <li><strong>Means of verification</strong> (indicators only)</li>
        <li><strong>Source</strong>: empty when staff record the value, or one of: <%= Object.entries(SOURCES).filter(([k]) => k !== 'manual').map(([, s]) => s.short).join(', ') %></li>
      </ol>
      <p class="mb-0">Rows go in order: each intermediate objective under the overall objective, each output under the intermediate objective above it, each activity under the output above it, and each indicator under the row above it. Nothing is saved if a row has a problem.</p>
    </div></div>
  </div>
</div>
<%- include('../partials/footer') %>
