<% if (admin) { const child = { objective: 'outcome', outcome: 'output', output: 'activity' }[r.level]; %>
<div class="lf-actions d-print-none">
  <a class="btn btn-sm btn-outline-secondary" href="/logframes/<%= project.id %>/results/<%= r.id %>/edit"><i class="bi bi-pencil" aria-hidden="true"></i> Edit<span class="visually-hidden"> <%= r.label %></span></a>
  <a class="btn btn-sm btn-outline-secondary" href="/logframes/<%= project.id %>/indicators/new?result=<%= r.id %>"><i class="bi bi-plus-lg" aria-hidden="true"></i> Indicator<span class="visually-hidden"> for <%= r.label %></span></a>
  <% if (child) { %><a class="btn btn-sm btn-outline-secondary" href="/logframes/<%= project.id %>/results/new?level=<%= child %>&amp;parent=<%= r.id %>"><i class="bi bi-plus-lg" aria-hidden="true"></i> <%= names[child] %><span class="visually-hidden"> under <%= r.label %></span></a><% } %>
  <form method="post" action="/logframes/<%= project.id %>/results/<%= r.id %>/delete" data-confirm="Remove <%= r.label %> and its indicators? Planned activities linked to it are kept but unlinked."><%- f.hidden(csrfToken) %><button class="btn btn-sm btn-outline-danger" type="submit" title="Remove"><i class="bi bi-trash" aria-hidden="true"></i><span class="visually-hidden">Remove <%= r.label %></span></button></form>
</div>
<% } %>
