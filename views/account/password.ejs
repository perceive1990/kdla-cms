<%- include('../partials/header') %>
<div class="page-head"><div><h1>Change password</h1>
  <% if (user.mustChangePassword) { %><p class="sub text-danger">Your password was set by an administrator. Please choose your own.</p><% } %></div></div>
<form method="post" action="/account/password" style="max-width: 520px;" novalidate>
  <%- f.hidden(csrfToken) %>
  <div class="panel"><div class="panel-body row g-3">
    <%- f.text('current', 'Current password', {}, errors, { type: 'password', required: true, autocomplete: 'current-password' }) %>
    <%- f.text('password', 'New password', {}, errors, { type: 'password', required: true, autocomplete: 'new-password', help: 'At least 10 characters. A short sentence is easy to remember.' }) %>
    <%- f.text('confirm', 'Repeat new password', {}, errors, { type: 'password', required: true, autocomplete: 'new-password' }) %>
  </div></div>
  <button class="btn btn-primary mt-3" type="submit">Change password</button>
</form>
<%- include('../partials/footer') %>
