<%- include('../partials/header') %>
<div class="page-head">
  <div>
    <div class="crumbs"><a href="/reports">Activity reports</a><% if (!isNew) { %> / <a href="/reports/<%= values.id %>"><%= values.heading %></a><% } %></div>
    <h1><%= isNew ? 'New activity report' : 'Edit report' %></h1>
  </div>
</div>
<% if (Object.keys(errors).length) { %><div class="alert alert-danger" role="alert">Please correct the highlighted fields.</div><% } %>

<form method="post" action="<%= isNew ? '/reports' : '/reports/' + values.id %>" enctype="multipart/form-data" novalidate>
  <%- f.hidden(csrfToken, isNew ? null : values._etag) %>
  <div class="panel"><div class="panel-body row g-3">
    <h2 class="panel-title">Activity</h2>
    <%- f.text('heading', 'Heading', values, errors, { required: true, maxlength: 300 }) %>
    <%- f.select('activityType', 'Type of activity', choices.activities, values, errors, { required: true, col: 'col-md-4' }) %>
    <%- f.text('date', 'Date of activity', values, errors, { type: 'date', required: true, col: 'col-md-3' }) %>
    <%- f.text('activityNumber', 'Activity number', values, errors, { type: 'number', min: 0, col: 'col-md-2', help: 'From the workplan' }) %>
    <%- f.select('district', 'District', choices.districts, values, errors, { col: 'col-md-3' }) %>
    <%- f.text('location', 'Venue or village', values, errors, { col: 'col-md-6', placeholder: 'e.g. Fisenge community hall' }) %>
    <%- f.select('projectId', 'Project', projects.map((p) => ({ value: p.id, label: p.title })), values, errors, { col: 'col-md-6', blank: projects.length ? 'Select…' : 'No projects set up yet' }) %>
    <%- f.select('compiledById', 'Report compiled by', users.map((u) => ({ value: u.id, label: u.fullName || u.username })), values, errors, { required: true, col: 'col-md-12' }) %>
  </div></div>

  <div class="panel"><div class="panel-body row g-3">
    <h2 class="panel-title">Report</h2>
    <%- f.textarea('introduction', 'Introduction', values, errors, { required: true, rows: 5 }) %>
    <%- f.textarea('objectives', 'Objectives', values, errors, { required: true, rows: 4 }) %>
    <%- f.textarea('implementation', 'Implementation of the activity', values, errors, { required: true, rows: 8 }) %>
    <%- f.textarea('immediateResults', 'Immediate results', values, errors, { rows: 5 }) %>
    <%- f.textarea('challenges', 'Challenges', values, errors, { rows: 4 }) %>
    <%- f.textarea('recommendations', 'Recommendations', values, errors, { rows: 4 }) %>
  </div></div>

  <div class="panel"><div class="panel-body row g-3">
    <h2 class="panel-title">Participants</h2>
    <%- f.multi('attendeeIds', 'Attendees already registered', attendees.map((a) => ({ value: a.id, label: h.fullName(a) + (a.activity ? ' · ' + a.activity : '') })), values, errors, { empty: 'No attendees registered yet.', help: 'After saving, use "Add attendance register" on the report page to enter many new attendees at once.' }) %>
    <%- f.text('otherParticipants', 'Other participants not individually registered', values, errors, { type: 'number', min: 0, col: 'col-md-6', help: 'e.g. estimated radio audience callers or a crowd count' }) %>
    <%- f.files({ label: isNew ? 'Attach files (attendance register, photos)' : 'Add more files', maxMb: config.storage.maxFileMb }) %>
  </div></div>

  <div class="d-flex gap-2 mt-3">
    <button class="btn btn-primary" type="submit"><%= isNew ? 'Save report' : 'Save changes' %></button>
    <a class="btn btn-outline-secondary" href="<%= isNew ? '/reports' : '/reports/' + values.id %>">Cancel</a>
  </div>
</form>
<%- include('../partials/footer') %>
