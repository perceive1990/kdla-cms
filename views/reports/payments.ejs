<%- include('../partials/header') %>
<% const m = (n) => (n ? Number(n).toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : ''); %>
<div class="page-head">
  <div>
    <div class="crumbs"><% urls.crumbs.forEach((c, i) => { %><%= i ? ' / ' : '' %><a href="<%= c.href %>"><%= c.label %></a><% }) %></div>
    <h1>Payment acquittal</h1>
    <p class="sub">The costs each eligible attendee receives · <%= info.title %><%= info.date ? ' · ' + h.fmtDate(info.date) : '' %><%= info.venue ? ' · ' + info.venue : '' %></p>
  </div>
  <div class="d-flex flex-wrap gap-2">
    <% if (t.people) { %><a class="btn btn-primary" href="<%= urls.print %>"><i class="bi bi-printer" aria-hidden="true"></i> Print acquittal form</a><% } %>
    <a class="btn btn-outline-secondary" href="<%= urls.people.href %>"><i class="bi bi-person-check" aria-hidden="true"></i> <%= urls.people.label %></a>
  </div>
</div>
<% if (!canEdit) { %><div class="alert alert-secondary small py-2"><i class="bi bi-lock" aria-hidden="true"></i> <%= lockedText %></div><% } %>

<% if (typeof fromPlan !== 'undefined' && fromPlan) { %><div class="alert alert-info small py-2"><i class="bi bi-diagram-3" aria-hidden="true"></i> These rates and allowances were prepared on the work plan before the activity. Check them against who attended, then save to keep them on this report.</div><% } %>
<form method="post" action="<%= urls.action %>">
  <%- f.hidden(csrfToken) %>
  <div class="panel"><div class="panel-body">
    <h2 class="panel-title">Costs for this activity</h2>
    <p class="small text-body-secondary">Tick the costs attendees of this activity are eligible for, set each rate and the number of days it is paid for (for example lunch for each day of a three-day workshop). Only the ticked costs appear below and on the printed form. Use Other for anything else, and name it.</p>
    <div class="row g-3 mb-2">
      <div class="col-6 col-md-3">
        <label class="form-label" for="currency">Currency</label>
        <select class="form-select" id="currency" name="currency"<%= canEdit ? '' : ' disabled' %>><% for (const c of CURRENCIES) { %><option<%= acq.currency === c ? ' selected' : '' %>><%= c %></option><% } %></select>
      </div>
    </div>
    <div class="table-wrap"><table class="table table-sm pay-costs">
      <thead><tr><th class="text-center">Eligible</th><th>Cost</th><th>Rate (<%= acq.currency %>)</th><th>Days</th></tr></thead>
      <tbody>
      <% for (const c of acq.costs) { %>
        <tr>
          <td class="text-center"><input class="form-check-input" type="checkbox" id="cost_<%= c.key %>" name="cost_<%= c.key %>" value="1" data-cost-toggle="<%= c.key %>"<%= c.on ? ' checked' : '' %><%= canEdit ? '' : ' disabled' %>></td>
          <td>
            <% if (c.other) { %>
              <input class="form-control form-control-sm" type="text" name="label_<%= c.key %>" value="<%= c.label %>" maxlength="40" placeholder="Other cost <%= c.n %>, for example Stationery" aria-label="Name of other cost <%= c.n %>" data-cost-label="<%= c.key %>"<%= canEdit ? '' : ' disabled' %>>
            <% } else { %>
              <label for="cost_<%= c.key %>"><%= c.label %><%= c.perNight ? ' (per night)' : '' %></label>
            <% } %>
          </td>
          <td><input class="form-control form-control-sm pay-rate" type="number" min="0" step="0.01" name="rate_<%= c.key %>" value="<%= c.rate ?? '' %>" placeholder="0.00" aria-label="Rate for <%= c.label || 'other cost ' + c.n %>"<%= canEdit ? '' : ' disabled' %>></td>
          <td><% if (c.perNight) { %><span class="small text-body-secondary">Nights per person, below</span><% } else { %><input class="form-control form-control-sm pay-nights" type="number" min="1" max="60" name="days_<%= c.key %>" value="<%= c.days || 1 %>" aria-label="Number of days for <%= c.label || 'other cost ' + c.n %>"<%= canEdit ? '' : ' disabled' %>><% } %></td>
        </tr>
      <% } %>
      </tbody>
    </table></div>
  </div></div>

  <div class="panel"><div class="panel-body">
    <div class="panel-head"><h2 class="panel-title">Eligible attendees</h2><span class="small text-body-secondary"><%= t.people %> on the acquittal · total <%= acq.currency %> <%= m(t.sums.total) || '0.00' %></span></div>
    <p class="small text-body-secondary">Tick the costs each person receives. A person is on the acquittal once at least one cost is ticked. <%= peopleNote %></p>
    <% if (!rows.length) { %>
      <p class="text-body-secondary mb-0"><%= emptyText %> <a href="<%= urls.people.href %>"><%= urls.people.label %></a>.</p>
    <% } else { %>
    <% const hide = (c) => (c.on ? '' : ' hidden'); const nameOf = (c) => c.label || 'Other ' + c.n; const acc = acq.costs.find((c) => c.key === 'accommodation'); %>
    <% if (canEdit) { %>
    <div class="d-flex flex-wrap gap-2 mb-2 small align-items-center">
      <span class="text-body-secondary">For everyone:</span>
      <% for (const c of acq.costs) { %><span data-cost-col="<%= c.key %>"<%= hide(c) %>><button class="btn btn-sm btn-outline-secondary" type="button" data-tick-all="<%= c.key %>" data-tick-label="<%= nameOf(c).toLowerCase() %>" hidden>Tick all <%= nameOf(c).toLowerCase() %></button></span><% } %>
    </div>
    <% } %>
    <div class="table-wrap"><table class="table table-sm pay-table">
      <thead><tr><th>Name</th><th>NRC</th><th>Phone</th>
        <% for (const c of acq.costs) { %><th class="text-center" data-cost-col="<%= c.key %>"<%= hide(c) %>><span data-cost-name="<%= c.key %>"><%= nameOf(c) %></span><% if (!c.perNight && c.days > 1) { %><div class="small fw-normal text-body-secondary"><%= c.days %> days</div><% } %></th><% } %>
        <th class="text-center" data-cost-col="accommodation"<%= hide(acc) %>>Nights</th><th class="text-end">Total</th></tr></thead>
      <tbody>
      <% for (const x of rows) { const p = x.person; const row = inList[p.id] || { items: {} }; const line = t.lines.find((l) => l.personId === p.id); const off = canEdit && !x.elsewhere ? '' : ' disabled'; %>
        <tr class="<%= line && line.total ? 'is-on' : '' %>">
          <td><%= p.firstName %> <%= p.lastName %><div class="small text-body-secondary"><%= x.attended ? 'Attended' : (x.invited ? 'Invited' : '') %><%= x.elsewhere ? ' · on another register of this activity' : '' %><%= p.location ? ' · ' + p.location : '' %></div></td>
          <td class="nowrap"><%= p.nrc || '' %></td><td class="nowrap"><%= p.contact || '' %></td>
          <% for (const c of acq.costs) { %><td class="text-center" data-cost-col="<%= c.key %>"<%= hide(c) %>><input class="form-check-input" type="checkbox" name="<%= c.key %>" value="<%= p.id %>"<%= row.items[c.key] ? ' checked' : '' %><%= off %> aria-label="<%= nameOf(c) %> for <%= p.firstName %> <%= p.lastName %>"></td><% } %>
          <td class="text-center" data-cost-col="accommodation"<%= hide(acc) %>><input class="form-control form-control-sm pay-nights" type="number" min="1" max="30" name="nights_<%= p.id %>" value="<%= row.nights || 1 %>" aria-label="Nights for <%= p.firstName %> <%= p.lastName %>"<%= off %>></td>
          <td class="text-end nowrap"><%= line && line.total ? m(line.total) : '' %></td>
        </tr>
      <% } %>
      </tbody>
      <% if (t.people) { %>
      <tfoot><tr><th colspan="3" class="text-end">Total (<%= acq.currency %>)</th>
        <% for (const c of acq.costs) { %><td class="text-center fw-semibold" data-cost-col="<%= c.key %>"<%= hide(c) %>><%= c.on ? m(t.sums[c.key]) : '' %></td><% } %>
        <td data-cost-col="accommodation"<%= hide(acc) %>></td><td class="text-end fw-semibold"><%= m(t.sums.total) %></td></tr></tfoot>
      <% } %>
    </table></div>
    <% } %>
    <% if (canEdit && rows.length) { %><button class="btn btn-primary mt-2" type="submit"><i class="bi bi-check2-square" aria-hidden="true"></i> Save the acquittal</button><% } %>
  </div></div>

  <% const ac = acq.activityCosts; const who = ac.responsibleId || defaultResponsible || ''; %>
  <div class="panel" id="activity-costs"><div class="panel-body">
    <div class="panel-head"><h2 class="panel-title">Activity costs</h2><span class="small text-body-secondary">total <%= acq.currency %> <%= m(ac.total) || '0.00' %></span></div>
    <p class="small text-body-secondary">Costs of running the activity, given to the person responsible to carry out their duties. They are not paid to attendees, so they are not on the acquittal form attendees sign. Leave a cost blank if it does not apply.</p>
    <div class="row g-3 mb-2">
      <div class="col-md-6">
        <label class="form-label" for="act_responsible">Person responsible</label>
        <select class="form-select" id="act_responsible" name="act_responsible"<%= canEdit ? '' : ' disabled' %>>
          <option value="">Choose</option>
          <% for (const s of staff) { %><option value="<%= s.id %>"<%= who === s.id ? ' selected' : '' %>><%= s.fullName || s.username %></option><% } %>
        </select>
      </div>
    </div>
    <div class="table-wrap"><table class="table table-sm act-costs">
      <thead><tr><th>Cost</th><th>Amount (<%= acq.currency %>)</th><th>Details</th></tr></thead>
      <tbody>
      <% for (const c of ac.items) { %>
        <tr>
          <td><label for="act_<%= c.key %>"><%= c.label %></label></td>
          <td><input class="form-control form-control-sm pay-rate" type="number" min="0" step="0.01" id="act_<%= c.key %>" name="act_<%= c.key %>" value="<%= c.amount ?? '' %>" placeholder="0.00"<%= canEdit ? '' : ' disabled' %>></td>
          <td><input class="form-control form-control-sm" type="text" maxlength="120" name="act_note_<%= c.key %>" value="<%= c.note %>" placeholder="<%= { venue: 'e.g. Civic Centre hall, 2 days', conference: 'e.g. 30 people × 2 days', organising: 'e.g. public address system, printing', stationery: 'e.g. flip charts, markers, notebooks' }[c.key] %>" aria-label="Details of <%= c.label.toLowerCase() %>"<%= canEdit ? '' : ' disabled' %>></td>
        </tr>
      <% } %>
      </tbody>
      <% if (ac.total) { %><tfoot><tr><th class="text-end">Total</th><td class="fw-semibold"><%= m(ac.total) %></td><td></td></tr></tfoot><% } %>
    </table></div>
    <% if (canEdit) { %><button class="btn btn-primary mt-2" type="submit"><i class="bi bi-check2-square" aria-hidden="true"></i> Save</button><% } %>
  </div></div>
</form>
<%- include('../partials/footer') %>
