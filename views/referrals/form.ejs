<%- include('../partials/header') %>
<div class="page-head">
  <div><div class="crumbs"><a href="/referrals">Referrals</a></div><h1>New referral</h1></div>
</div>
<% if (Object.keys(errors).length) { %><div class="alert alert-danger" role="alert">Please correct the highlighted fields.</div><% } %>
<% if (!orgs.length) { %>
  <div class="alert alert-info">No stakeholder organisations yet. <a href="/stakeholders/new">Add the organisation</a> first.</div>
<% } %>
<% if (gaps && gaps.length) { %>
  <div class="callout mb-3" role="alert"><strong><i class="bi bi-shield-exclamation"></i> Consent to share not recorded</strong> for
    <% gaps.forEach((p, i) => { %><%= i ? ', ' : '' %><a href="/people/clients/<%= p.id %>"><%= h.fullName(p) %></a><% }) %>.
    Ask the client before sharing their details with another organisation, then record their answer on their page.</div>
<% } %>
<form method="post" action="/referrals" novalidate>
  <%- f.hidden(csrfToken) %>
  <div class="panel"><div class="panel-body row g-3">
    <%- f.select('caseId', 'Case', cases.map((c) => ({ value: c.id, label: c.caseNumber + ' · ' + c.heading })), values, errors, { required: true, help: 'Only cases you can open are listed.' }) %>
    <%- f.select('organizationId', 'Referred to', orgs.map((o) => ({ value: o.id, label: o.name })), values, errors, { required: true, col: 'col-md-6' }) %>
    <%- f.select('followUp', 'Follow up', choices.followUpNeeds, values, errors, { required: true, col: 'col-md-6', blank: false }) %>
    <%- f.textarea('reason', 'Reason for referral', values, errors, { rows: 4 }) %>
    <%- f.checkbox('markReferred', 'Set the case status to "Open Referred"', values.markReferred) %>
  </div></div>
  <div class="d-flex gap-2 mt-3">
    <button class="btn btn-primary" type="submit">Save referral</button>
    <a class="btn btn-outline-secondary" href="/referrals">Cancel</a>
  </div>
</form>
<%- include('../partials/footer') %>
