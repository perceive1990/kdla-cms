<%- include('../partials/header') %>
<div class="page-head">
  <div>
    <div class="crumbs"><a href="/workplans">Work plans</a> / <a href="/workplans/<%= plan.id %>"><%= plan.title %></a></div>
    <h1><%= isNew ? 'Add planned activity' : 'Edit planned activity' %></h1>
    <p class="sub">Plan period: <%= h.fmtDate(plan.periodStart) %> to <%= h.fmtDate(plan.periodEnd) %></p>
  </div>
</div>
<% if (Object.keys(errors).length) { %><div class="alert alert-danger" role="alert">Please correct the highlighted fields.</div><% } %>
<form method="post" action="<%= isNew ? '/workplans/' + plan.id + '/activities' : '/workplans/' + plan.id + '/activities/' + values.id %>" novalidate>
  <%- f.hidden(csrfToken) %>
  <% if (!isNew && values.updatedAt) { %><input type="hidden" name="_version" value="<%= values.updatedAt %>"><% } %>
  <div class="panel"><div class="panel-body row g-3">
    <h2 class="panel-title">Activity</h2>
    <%- f.text('number', 'Activity number', values, errors, { type: 'number', min: 0, col: 'col-md-2', help: 'Used on activity reports' }) %>
    <%- f.text('title', 'Activity', values, errors, { required: true, maxlength: 300, col: 'col-md-10', placeholder: 'e.g. Community sensitisation on customary land rights' }) %>
    <%- f.select('activityType', 'Type of activity', choices.activities, values, errors, { col: 'col-md-4', blank: 'Any type' }) %>
    <%- f.select('district', 'District', choices.districts, values, errors, { col: 'col-md-4', blank: 'Any district' }) %>
    <%- f.select('responsibleId', 'Responsible', users.map((u) => ({ value: u.id, label: u.fullName || u.username })), values, errors, { col: 'col-md-4', blank: 'Not assigned' }) %>
    <%- f.text('startDate', 'Start', values, errors, { type: 'date', col: 'col-md-3', min: plan.periodStart, max: plan.periodEnd }) %>
    <%- f.text('endDate', 'End', values, errors, { type: 'date', col: 'col-md-3', min: plan.periodStart, max: plan.periodEnd, help: 'Shown as overdue after this date' }) %>
    <%- f.select('status', 'Status', choices.workplanActivityStatuses, values, errors, { col: 'col-md-3', blank: false }) %>
  </div></div>
  <div class="panel"><div class="panel-body row g-3">
    <h2 class="panel-title">Targets and budget</h2>
    <%- f.text('targetEvents', 'How many times', values, errors, { type: 'number', min: 0, col: 'col-md-3', help: 'Each linked activity report counts once' }) %>
    <%- f.text('targetPeople', 'People to reach', values, errors, { type: 'number', min: 0, col: 'col-md-3' }) %>
    <%- f.text('budget', 'Budget (' + plan.currency + ')', values, errors, { type: 'number', min: 0, step: '0.01', col: 'col-md-3' }) %>
    <%- f.textarea('output', 'Expected output or indicator', values, errors, { rows: 3, placeholder: 'e.g. 300 people understand how to register customary land' }) %>
  </div></div>
  <div class="d-flex flex-wrap gap-2 mt-3">
    <button class="btn btn-primary" type="submit"><%= isNew ? 'Add activity' : 'Save changes' %></button>
    <% if (isNew) { %><button class="btn btn-outline-primary" type="submit" name="next" value="another">Add and add another</button><% } %>
    <a class="btn btn-outline-secondary" href="/workplans/<%= plan.id %>">Cancel</a>
  </div>
</form>
<%- include('../partials/footer') %>
