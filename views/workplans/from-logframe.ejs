<%- include('../partials/header') %>
<div class="page-head">
  <div>
    <div class="crumbs"><a href="/workplans">Work plans</a> / <a href="/workplans/<%= plan.id %>"><%= plan.title %></a></div>
    <h1>Add activities from the logframe</h1>
    <p class="sub"><%= project ? project.title + ' · ' : '' %>Plan period <%= h.fmtDate(plan.periodStart) %> to <%= h.fmtDate(plan.periodEnd) %></p>
  </div>
</div>

<% if (!fw) { %>
  <form class="panel" method="get" action="/workplans/<%= plan.id %>/from-logframe">
    <div class="panel-body row g-3 align-items-end">
      <p class="mb-0 col-12">This work plan is not for one project. Choose the project whose logframe to draw from.</p>
      <%- f.select('project', 'Project', projects.map((p) => ({ value: p.id, label: p.title })), {}, {}, { col: 'col-md-6', required: true, blank: 'Choose…' }) %>
      <div class="col-md-3"><button class="btn btn-primary" type="submit">Show its activities</button></div>
    </div>
  </form>
<% } else if (!rows.length) { %>
  <div class="panel"><div class="empty"><i class="bi bi-diagram-3"></i>The logframe of <%= project.title %> has no activities or outputs yet. <a href="/logframes/<%= fw.id %>">Open the logframe</a>.</div></div>
<% } else { %>
<% if (Object.keys(rowErrors).length) { %><div class="alert alert-danger" role="alert">Some of the ticked activities need attention. Nothing was added.</div><% } %>
<p class="small text-body-secondary">Tick the logframe activities this plan will carry out, then set who is responsible, the dates, how many times and the budget. Each one becomes a planned activity linked to the logframe, so its activity reports count towards the results. You can change the titles, for example to name the place.</p>
<form method="post" action="/workplans/<%= plan.id %>/from-logframe" novalidate>
  <%- f.hidden(csrfToken) %>
  <% if (!plan.projectId) { %><input type="hidden" name="project" value="<%= fw.projectId %>"><% } %>
  <div class="wp-pick" data-autotick>
    <% let lastOutput = null; rows.forEach((r, i) => { const v = rowValues[i] || {}; const err = rowErrors[i]; const checked = rowValues[i] ? v.add === 'on' : false; %>
      <% if (r.outputId && r.outputId !== lastOutput) { lastOutput = r.outputId; %>
        <div class="wp-pick-group"><span class="lf-label"><%= r.outputLabel %></span> <%= r.outputText %></div>
      <% } %>
      <div class="wp-pick-row<%= err ? ' has-error' : '' %>" data-row>
        <div><input class="form-check-input" type="checkbox" id="add-<%= i %>" name="rows[<%= i %>][add]"<%= checked ? ' checked' : '' %> aria-describedby="title-<%= i %>"><input type="hidden" name="rows[<%= i %>][resultId]" value="<%= r.resultId %>"></div>
        <div>
          <label for="add-<%= i %>"><span class="lf-label"><%= r.label %></span> <span class="text-body-secondary">add to this plan</span><% if (r.already) { %> <span class="tag tag-muted">already <%= r.already === 1 ? 'once' : r.already + ' times' %> in this plan</span><% } %></label>
          <label class="visually-hidden" for="title-<%= i %>">Title of the planned activity for <%= r.label %></label>
          <input class="form-control" id="title-<%= i %>" name="rows[<%= i %>][title]" value="<%= v.title ?? r.text.slice(0, 300) %>" maxlength="300">
          <% if (err) { %><div class="invalid-feedback d-block"><%= err %></div><% } %>
          <div class="wp-pick-fields">
            <label class="wp-pick-field"><span>Responsible</span><select class="form-select form-select-sm" name="rows[<%= i %>][responsibleId]">
              <option value="">Not assigned</option>
              <% for (const u of users) { %><option value="<%= u.id %>"<%= v.responsibleId === u.id ? ' selected' : '' %>><%= u.fullName || u.username %></option><% } %>
            </select></label>
            <label class="wp-pick-field"><span>Venue</span><input class="form-control form-control-sm" name="rows[<%= i %>][venue]" value="<%= v.venue ?? '' %>" maxlength="200" placeholder="e.g. Fisenge hall"></label>
            <label class="wp-pick-field"><span>Start</span><input class="form-control form-control-sm" type="date" name="rows[<%= i %>][startDate]" value="<%= v.startDate ?? plan.periodStart %>" min="<%= plan.periodStart %>" max="<%= plan.periodEnd %>"></label>
            <label class="wp-pick-field"><span>End</span><input class="form-control form-control-sm" type="date" name="rows[<%= i %>][endDate]" value="<%= v.endDate ?? plan.periodEnd %>" min="<%= plan.periodStart %>" max="<%= plan.periodEnd %>"></label>
            <label class="wp-pick-field"><span>How many times</span><input class="form-control form-control-sm" type="number" min="0" name="rows[<%= i %>][targetEvents]" value="<%= v.targetEvents ?? 1 %>"></label>
            <label class="wp-pick-field"><span>People to reach</span><input class="form-control form-control-sm" type="number" min="0" name="rows[<%= i %>][targetPeople]" value="<%= v.targetPeople ?? '' %>"></label>
            <label class="wp-pick-field"><span>Budget (<%= plan.currency %>)</span><input class="form-control form-control-sm" type="number" min="0" step="0.01" name="rows[<%= i %>][budget]" value="<%= v.budget ?? '' %>"></label>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
  <div class="d-flex flex-wrap gap-2 mt-3">
    <button class="btn btn-primary" type="submit"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add the ticked activities</button>
    <a class="btn btn-outline-secondary" href="/workplans/<%= plan.id %>">Cancel</a>
  </div>
</form>
<% } %>
<%- include('../partials/footer') %>
