<div class="wp-actions <%= cls %> d-print-none">
  <a class="btn btn-sm btn-outline-secondary" href="/workplans/<%= plan.id %>/activities/<%= it.id %>/shortlist" title="Shortlist who to invite"><i class="bi bi-people" aria-hidden="true"></i> Invite list<%= (it.shortlist || []).length ? ' (' + it.shortlist.length + ')' : '' %><span class="visually-hidden"> for <%= label %></span></a>
  <a class="btn btn-sm btn-outline-secondary" href="/workplans/<%= plan.id %>/activities/<%= it.id %>/register" title="Print an attendance register to sign at the meeting"><i class="bi bi-pen" aria-hidden="true"></i> Register<span class="visually-hidden"> for signing, <%= label %></span></a>
  <% if (canReport) { %><a class="btn btn-sm btn-outline-primary" href="/reports/new?workplanItem=<%= plan.id %>:<%= it.id %>"><i class="bi bi-journal-plus" aria-hidden="true"></i> Write report<span class="visually-hidden"> for <%= label %></span></a><% } %>
  <% if (canEdit) { %>
    <a class="btn btn-sm btn-outline-secondary" href="/workplans/<%= plan.id %>/activities/<%= it.id %>/edit"><i class="bi bi-pencil" aria-hidden="true"></i> Edit<span class="visually-hidden"> <%= label %></span></a>
    <form method="post" action="/workplans/<%= plan.id %>/activities/<%= it.id %>/delete" data-confirm="Remove <%= label %>? Linked activity reports are kept but unlinked."><%- f.hidden(csrfToken) %><button class="btn btn-sm btn-outline-danger" type="submit" title="Remove"><i class="bi bi-trash" aria-hidden="true"></i><span class="visually-hidden">Remove <%= label %></span></button></form>
  <% } %>
</div>
