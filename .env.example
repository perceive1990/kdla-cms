# Copy to .env for local development. In Azure, set these under App Service > Settings > Environment variables
# (infra/provision.sh sets them for you).
NODE_ENV=development
PORT=3000
SESSION_SECRET=replace-with-a-long-random-string-of-32-or-more-characters

# Database: "cosmos" in Azure, "memory" for local development (no Azure needed).
DB_DRIVER=memory
MEMORY_DB_FILE=./data/dev-db.json

# Azure Cosmos DB for NoSQL (use either the connection string or endpoint + key)
COSMOS_CONNECTION_STRING=
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=kdla-cms
# 1000 = the whole free-tier allowance, shared by all containers. Use 0 for a serverless account.
COSMOS_THROUGHPUT=1000

# File attachments: Azure Blob Storage (recommended) or local disk
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=case-files
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=10

# First administrator, created only when no administrator exists. Remove the password after first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password-now

# Security
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=12
LOGIN_MAX_FAILURES=5
LOCK_MINUTES=15
# Two-step verification: none (optional), admins (required for administrators) or all
REQUIRE_2FA=none
# Audit trail entries are deleted after this many days (0 = keep forever)
AUDIT_RETENTION_DAYS=1095

# REST API at /api/v1 (documentation at /api/docs). Set API_ENABLED=false to switch it off.
API_ENABLED=true
# Hours a token from POST /api/v1/auth/login lasts
API_TOKEN_HOURS=12
# Longest life of a personal access token (Account > API access)
API_PERSONAL_TOKEN_MAX_DAYS=365
# Requests per minute for each token
API_RATE_LIMIT=240
# Web sites allowed to call the API from a browser, comma separated (empty = none)
API_CORS_ORIGINS=

# Organisation details (used on letters and pages)
ORG_NAME=KDLA
ORG_FULL_NAME=Kitwe District Land Alliance
ORG_ADDRESS=Kitwe, Zambia
ORG_CONTACT=
APP_NAME=KDLA Case Management System
DISPLAY_TIMEZONE=Africa/Lusaka
